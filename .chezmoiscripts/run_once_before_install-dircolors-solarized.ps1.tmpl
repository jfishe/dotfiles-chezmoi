{{- if eq .chezmoi.os "windows" -}}
#Requires -Version 5.1
$ErrorActionPreference = 'Stop'

$RepoUrl = 'https://github.com/seebi/dircolors-solarized.git'
$TargetPath = Join-Path $env:LOCALAPPDATA 'dircolors-solarized'

# Safety guard: if anything already exists at this path, never touch it.
# An existing clone may have local edits that must never be reset or
# replaced.
if (Test-Path -LiteralPath $TargetPath) {
    Write-Host "==> $TargetPath already exists, skipping clone"
    exit 0
}

if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    throw "git.exe not found on PATH. Install Git for Windows first, then " +
          "re-run 'chezmoi apply' -- this script retries automatically " +
          "since it only records success once the clone completes."
}

Write-Host "==> Cloning $RepoUrl to $TargetPath"
git clone $RepoUrl $TargetPath
if ($LASTEXITCODE -ne 0) {
    throw "git clone failed with exit code $LASTEXITCODE"
}
{{- end -}}
