[user]
	name = John D. Fisher
	email = jdfenw@gmail.com
		; Set these in ~/.bash_profile or ~/.bashrc to overide:
		; GIT_AUTHOR_NAME is the human-readable name in the “author” field.
		; GIT_AUTHOR_EMAIL is the email for the “author” field.
		; GIT_AUTHOR_DATE is the timestamp used for the “author” field.
		; GIT_COMMITTER_NAME sets the human name for the “committer” field.
		; GIT_COMMITTER_EMAIL is the email address for the “committer” field.
		; GIT_COMMITTER_DATE is used for the timestamp in the “committer” field.
		; EMAIL is the fallback email address in case the user.email configuration
		; value isn’t set. If this isn’t set, Git falls back to the system user and
		; host names.
[core]
	editor = vim
	eol = lf
	autocrlf = input
	attributesfile = ~/.gitattributes_global
	excludesfile = ~/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	# https://dandavison.github.io/delta/
	navigate = true    # use n and N to move between diff sections

	# delta detects terminal colors automatically; set one of these to disable auto-detection
	# dark = true
	# light = true

[gui]
	displayuntracked = false
[push]
	default = simple
[log]
	decorate = auto
[diff "msword"]
	textconv = astextplain
	wordRegex = "\\w+"
[diff "excel"]
	command = xldiff.bat
[diff]
	tool = vimdiff
	colorMoved = default
[difftool]
	prompt = false
[merge]
	conflictstyle = diff3
	tool = vimdiff
[mergetool]
	prompt = false
	keepBackup = false
[rerere]
	enabled = true
	autoupdate = true
[color]
	ui = true
[commit]
	template = ~/.gitmessage.txt
	cleanup = strip
	verbose = true
[status]
	showUntrackedFiles = no
[init]
	defaultbranch = main
[alias]
	root = rev-parse --show-toplevel
	alias = ! git config --get-regexp ^alias\\. | sed -e s/^alias\\.// -e s/\\ /\\ =\\ /
	wdiff = diff --word-diff
	sh = show --name-only
[pull]
	rebase = merges
[include]
	path = ~/.dotfiles/.gitconfig
	; gitconfig is installation specific. Put the actual path in the file when cloning dotfiles.
	; [credential]
	;		helper = /mnt/c/Program\\ Files/Git/mingw64/libexec/git-core/git-credential-wincred.exe
[url "https://github.com/"]
	insteadOf = git@github.com:
[url "https://"]
	insteadOf = git://
