# ~/.config/ctags/defaults.ctags
#
# Universal Ctags looks for *.ctags config in (first match wins the
# XDG_CONFIG_HOME/HOME choice, the rest all load together):
#   $XDG_CONFIG_HOME/ctags/*.ctags   (on Windows, XDG_CONFIG_HOME defaults to %APPDATA%)
#   $HOME/.config/ctags/*.ctags      (used when XDG_CONFIG_HOME is unset)
#   $HOME/.ctags.d/*.ctags
#   $HOMEDRIVE$HOMEPATH/ctags.d/*.ctags   (Windows only)
#   ./.ctags.d/*.ctags, ./ctags.d/*.ctags (project-local, per invocation)
#
# Everything lives in this single file, in this order, on purpose: ctags
# applies options top-to-bottom, and --exclude only affects paths walked
# after it's registered — so all excludes are listed before --recurse.
# (exclude.ctags / windows_home.ctags are kept as empty placeholders;
# splitting excludes into another file made their order relative to
# --recurse depend on alphabetical *.ctags load order, which is fragile.)

# ===========================================================================
# Excludes
# ===========================================================================

# --- Version control ---------------------------------------------------
--exclude=.git
--exclude=.hg
--exclude=.svn

# --- ctags' own output/config, so a tags file never re-tags itself -----
--exclude=tags
--exclude=.tags
# --exclude=.ctags
# --exclude=.ctags.d
# --exclude=ctags.d

# --- Editors / IDEs -----------------------------------------------------
--exclude=.vscode
--exclude=.vscode-insiders
--exclude=.vscode-remote-containers
--exclude=.obsidian
# --exclude=.idea
--exclude=.vim
# --exclude=vim??
--exclude=vimfiles

# --- Python ---------------------------------------------------------------
--exclude=.venv
# --exclude=venv
# --exclude=env
--exclude=.tox
--exclude=.pixi
--exclude=.mypy_cache
--exclude=.pytest_cache
--exclude=.ruff_cache
--exclude=__pycache__
# --exclude=*.py[cod]
# --exclude=*$py.class
# --exclude=.anaconda
# --exclude=.pylint.d
# --exclude=Miniforge3

# --- PowerShell -------------------------------------------------------
# Documents\PowerShell\Modules (and WindowsPowerShell\Modules) is PowerShell's
# node_modules: installed third-party module code. PSScriptAnalyzer alone
# ships compatibility_profiles/*.json files that are huge cmdlet/parameter
# catalogs (one per OS+PS-version combo) - ctags' JSON parser tags every
# object key in them. Measured: this one exclude removes ~99.7% of a 14.5M
# tag / 5.8GB tags file. Moved out of the "may hold real source" list below.
--exclude=Modules

# --- Node / web builds ----------------------------------------------------
--exclude=node_modules
# --exclude=*.min.js
# --exclude=*.min.css
# --exclude=*.bundle.js
# --exclude=*.chunk.js

# --- Build output / tool caches -------------------------------------------
--exclude=.cache
--exclude=.cargo
--exclude=.claude
--exclude=.claude.json
--exclude=.config
--exclude=.cookiecutter_replay
--exclude=.cookiecutters
--exclude=.copilot
--exclude=.docker
--exclude=.jupyter
--exclude=.local/share
--exclude=.matplotlib
--exclude=Zotero
--exclude=_build
--exclude=build

# --- Generated content ------------------------------------------------
# vimwiki's rendered HTML output - generated, not source.
--exclude=vimwiki_html
--exclude=vimwiki_home_html

# --- Recycle bin / temp ----------------------------------------------------
--exclude=$RECYCLE.BIN
--exclude=RECYCLER
--exclude=Temp
--exclude=temp
--exclude=tmp
--exclude=*.temp
--exclude=*.tmp
# --exclude=pack

# --- Windows profile clutter (mainly matters for a whole-$HOME scan) ------
--exclude=AppData
--exclude=Local
--exclude=OneDrive
--exclude=Google Drive
--exclude=iCloudDrive
--exclude=Roaming
--exclude=Intel
--exclude=IntelGraphicsProfiles
--exclude=MathJax

# --- Folders that may hold real source: left included by default ----------
# --exclude=Desktop
# --exclude=Documents
# --exclude=Downloads
# --exclude=GitHub
# --exclude=Pictures
# --exclude=Videos
# --exclude=Scripts
# (Modules moved to the PowerShell section above - it's a dependency
# cache, not source, per the measurement noted there.)

# --- Misc --------------------------------------------------------------
# --exclude=.env
# --exclude=*.ini
# --exclude=.DS_Store

# --- Site-specific: confirm these still point at real paths on this machine
--exclude=userprofile
--exclude=winhome
--exclude=dev

# ===========================================================================
# Behavior (must come after the excludes above)
# ===========================================================================

--recurse=yes
--sort=yes
--tag-relative=yes

# Keep fields modest: line numbers + kind cover most editor integrations.
# Add more only if something you use actually needs them (e.g. +z for
# scope — but check your ctags build supports it before relying on it).
--fields=+nK

# --extras= intentionally left unset: extra tag classes (file tags,
# pseudo-tags, etc.) aren't compatible with Gutentags, and re-running
# ctags without deleting the previous tags file first can duplicate entries.
